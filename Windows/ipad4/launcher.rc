#include <windows.h>
1 ICON "crates/lighttouch/assets/icon/lighttouch.ico"
1 VERSIONINFO
FILEVERSION 0, 5, 0, 0
PRODUCTVERSION 0, 5, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "LightTouch iPad 4 launcher"
            VALUE "ProductName", "LightTouch iPad 4"
            VALUE "OriginalFilename", "LightTouch-iPad4.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
