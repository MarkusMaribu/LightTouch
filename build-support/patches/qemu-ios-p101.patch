diff --git a/tests/slice/p101-boot-wake.c b/tests/slice/p101-boot-wake.c
new file mode 100644
index 0000000000..a85d902914
--- /dev/null
+++ b/tests/slice/p101-boot-wake.c
@@ -0,0 +1,120 @@
+/* SLICE hw/arm/s5l8950.c fn p101_tap_home p101_boot_wake p101_mouse_event
+ * SLICE:panel include/hw/arm/s5l8955.h define P101_PANEL_.*
+ * CFLAGS -Wall -Werror
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include "panel.h"
+
+_Static_assert(P101_PANEL_WIDTH == 1536 && P101_PANEL_HEIGHT == 2048,
+               "P101 scanout uses native portrait coordinates");
+
+enum { QEMU_CLOCK_VIRTUAL, IPOD_TOUCH_BUTTON_HOME };
+typedef struct {
+    bool *display;
+    int64_t *boot_wake_timer;
+    int64_t boot_wake_deadline;
+    int64_t boot_dark_since;
+    bool wake_click;
+} S5L8950State;
+
+typedef struct {
+    bool touch_down;
+} IPodTouchMultitouchState;
+
+static S5L8950State *machine;
+static int64_t guest_time;
+static unsigned presses;
+static unsigned touches;
+
+#define S5L8950_MACHINE(obj) (obj)
+
+static S5L8950State *qdev_get_machine(void)
+{
+    return machine;
+}
+
+static void a6_mouse_event(void *opaque, int x, int y, int z, int buttons)
+{
+    IPodTouchMultitouchState *mt = opaque;
+
+    (void)x;
+    (void)y;
+    (void)z;
+    mt->touch_down = buttons != 0;
+    touches++;
+}
+
+static int64_t qemu_clock_get_ms(int clock)
+{
+    assert(clock == QEMU_CLOCK_VIRTUAL);
+    return guest_time;
+}
+
+static bool s5l8930_display_active(bool *active)
+{
+    return *active;
+}
+
+static void s5l8950_press_button(int button, bool down)
+{
+    assert(button == IPOD_TOUCH_BUTTON_HOME);
+    assert(down == ((presses & 1) == 0));
+    presses++;
+}
+
+static void timer_mod(int64_t *pending, int64_t deadline)
+{
+    *pending = deadline;
+}
+
+#include "slice.h"
+
+static void tick(S5L8950State *s, int64_t now)
+{
+    guest_time = now;
+    *s->boot_wake_timer = -1;
+    p101_boot_wake(s);
+}
+
+int main(void)
+{
+    bool active = true;
+    int64_t pending;
+    S5L8950State s = {
+        .display = &active,
+        .boot_wake_timer = &pending,
+        .boot_wake_deadline = 120000,
+        .boot_dark_since = -1,
+    };
+
+    tick(&s, 30000);
+    assert(pending == 30250 && presses == 0);
+    active = false;
+    tick(&s, 40000);
+    assert(pending == 40250 && s.boot_dark_since == 40000);
+    active = true;
+    tick(&s, 40500);
+    assert(s.boot_dark_since == -1 && presses == 0);
+    active = false;
+    tick(&s, 41000);
+    tick(&s, 41500);
+    assert(pending == 41750 && presses == 0);
+    tick(&s, 41750);
+    assert(pending == -1 && presses == 2);
+    tick(&s, 120000);
+    assert(pending == -1 && presses == 2);
+
+    IPodTouchMultitouchState mt = {0};
+    machine = &s;
+    p101_mouse_event(&mt, 100, 100, 0, 1);
+    assert(s.wake_click && presses == 4 && touches == 0);
+    active = true;
+    p101_mouse_event(&mt, 120, 100, 0, 1);
+    p101_mouse_event(&mt, 120, 100, 0, 0);
+    assert(!s.wake_click && touches == 0);
+    p101_mouse_event(&mt, 120, 100, 0, 1);
+    assert(touches == 1 && mt.touch_down);
+    return 0;
+}
diff --git a/tests/slice/sdl2-window-fit.c b/tests/slice/sdl2-window-fit.c
new file mode 100644
index 0000000000..dca9c47b44
--- /dev/null
+++ b/tests/slice/sdl2-window-fit.c
@@ -0,0 +1,56 @@
+/* SLICE ui/sdl2.c fn sdl2_fit_size sdl2_mouse_axis sdl2_unrotate sdl2_direct_button_state
+ * CFLAGS -Wall -Werror
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#include "slice.h"
+
+static void check_fit(int width, int height, int max_w, int max_h,
+                      int expected_w, int expected_h)
+{
+    sdl2_fit_size(&width, &height, max_w, max_h);
+    assert(width == expected_w);
+    assert(height == expected_h);
+}
+
+int main(void)
+{
+    check_fit(2048, 1536, 1904, 992, 1322, 992);
+    check_fit(2048, 1536, 1000, 1200, 1000, 750);
+    check_fit(1536, 2048, 1120, 700, 525, 700);
+    check_fit(640, 480, 1904, 992, 640, 480);
+    check_fit(2048, 1536, 1, 1, 1, 1);
+
+    /* SDL delivers logical 2D coordinates, even with a non-4:3 window. */
+    assert(sdl2_mouse_axis(834, 1000, 2048, true) == 834);
+    assert(sdl2_mouse_axis(1408, 800, 1536, true) == 1408);
+    assert(sdl2_mouse_axis(-20, 1000, 2048, true) == -20);
+
+    /* Other renderers deliver coordinates in window units. */
+    assert(sdl2_mouse_axis(500, 1000, 2048, false) == 1024);
+    assert(sdl2_mouse_axis(400, 800, 1536, false) == 768);
+    assert(sdl2_mouse_axis(-10, 1000, 2048, false) == -20);
+
+    /* Letterbox clicks never start a touch. A drag can end in the bars. */
+    assert(sdl2_direct_button_state(0, 1, true, -30, 760, 2048, 1536) == 0);
+    assert(sdl2_direct_button_state(0, 1, true, 1024, 1536, 2048, 1536) == 0);
+    assert(sdl2_direct_button_state(0, 1, true, 2047, 1535, 2048, 1536) == 1);
+    assert(sdl2_direct_button_state(1, 1, false, 2060, 1600, 2048, 1536) == 0);
+    /* Landscape top left and bottom right on the native portrait panel. */
+    int x = 0, y = 0;
+    sdl2_unrotate(&x, &y, 1535);
+    assert(x == 1535 && y == 0);
+    x = 2047; y = 1535;
+    sdl2_unrotate(&x, &y, 1535);
+    assert(x == 0 && y == 2047);
+    x = -1; y = 100;
+    sdl2_unrotate(&x, &y, 1535);
+    assert(sdl2_direct_button_state(0, 1, true, x, y, 1536, 2048) == 0);
+    x = 12; y = -7;
+    sdl2_unrotate(&x, &y, 0);
+    assert(x == 7 && y == 12);
+    return 0;
+}
