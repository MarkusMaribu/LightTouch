+static SDL_Texture *sdl2_2d_minify(struct sdl2_console *scon)
+{
+    SDL_Renderer *renderer = scon->real_renderer;
+    SDL_Texture *source = scon->texture;
+    int width = surface_width(scon->surface);
+    int height = surface_height(scon->surface);
+    float scale_x, scale_y;
+    const char *quality;
+
+    /*
+     * A bilinear sample covers only two texels on each axis. At larger
+     * reductions, thin strokes can disappear between samples. Halve the
+     * image in stages, then let the logical viewport do the final fit.
+     */
+    SDL_RenderGetScale(renderer, &scale_x, &scale_y);
+    if (scale_x <= 0 || scale_y <= 0 || scale_x >= 0.5f || scale_y >= 0.5f ||
+        !SDL_RenderTargetSupported(renderer)) {
+        return source;
+    }
+    /* Preserve an explicit nearest-neighbour preference. */
+    quality = SDL_GetHint(SDL_HINT_RENDER_SCALE_QUALITY);
+    if (!quality || quality[0] == '0' || !SDL_strcasecmp(quality, "nearest")) {
+        return source;
+    }
+    for (int level = 0; scale_x < 0.5f && scale_y < 0.5f &&
+         width > 1 && height > 1; level++) {
+        char key[40];
+        int old_width, old_height;
+        SDL_Texture *half;
+
+        width = (width + 1) / 2;
+        height = (height + 1) / 2;
+        /* The renderer owns these cached targets until window destruction. */
+        snprintf(key, sizeof(key), "qemu.sdl2.minify.%d", level);
+        half = SDL_GetWindowData(scon->real_window, key);
+        if (half && (SDL_QueryTexture(half, NULL, NULL,
+                                     &old_width, &old_height) < 0 ||
+                     old_width != width || old_height != height)) {
+            SDL_DestroyTexture(half);
+            SDL_SetWindowData(scon->real_window, key, NULL);
+            half = NULL;
+        }
+        if (!half) {
+            half = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+                                     SDL_TEXTUREACCESS_TARGET, width, height);
+            if (!half) {
+                break;
+            }
+            SDL_SetWindowData(scon->real_window, key, half);
+        }
+        if (SDL_SetRenderTarget(renderer, half) < 0 ||
+            SDL_RenderCopy(renderer, source, NULL, NULL) < 0) {
+            break;
+        }
+        source = half;
+        scale_x *= 2;
+        scale_y *= 2;
+    }
+    SDL_SetRenderTarget(renderer, NULL);
+    return source;
+}
