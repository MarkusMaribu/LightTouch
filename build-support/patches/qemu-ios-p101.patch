+    assert(irq_level == 0);
+    address(&s, 1);
+    for (unsigned i = 1; i < 10; i++)
+        assert(a6_pmu_recv(&s) == 0);
+    assert(irq_level == 0 && a6_pmu_recv(&s) == 4 && irq_level == 1);
+
+    const unsigned inputs[][2] = {{2, 819}, {8, 1051}, {11, 819}, {30, 2360}};
+    for (unsigned i = 0; i < sizeof(inputs) / sizeof(inputs[0]); i++) {
+        write_reg(&s, 0x48, 0x40 | inputs[i][0]);
+        assert(timer.armed);
+        timer.armed = false;
+        a6_pmu_adc_complete(&s);
+        assert((unsigned)(s.regs[0x49] | (s.regs[0x4a] << 4)) == inputs[i][1]);
+        address(&s, 0x0a);
+        assert(a6_pmu_recv(&s) == 4);
+    }
+    write_reg(&s, 0x48, 0x40);
+    write_reg(&s, 0x48, 0);
+    assert(!timer.armed && irq_level == 1);
+}
