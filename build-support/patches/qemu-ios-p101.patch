+
+typedef struct {
+    int unused;
+} DisplayChangeListener;
+
+typedef struct {
+    int width, height;
+    uint32_t pixels[128 * 96];
+} DisplaySurface;
+
+struct sdl2_console {
+    DisplayChangeListener dcl;
+    DisplaySurface *surface;
+    SDL_Renderer *real_renderer;
+    SDL_Texture *texture;
+    SDL_Window *real_window;
+    bool opengl;
+    bool landscape;
+};
+
+#define container_of(p, t, m) ((t *)((char *)(p) - offsetof(t, m)))
+#define surface_width(s) ((s)->width)
+#define surface_height(s) ((s)->height)
+#define surface_bytes_per_pixel(s) 4
+#define surface_stride(s) ((s)->width * 4)
+#define surface_data(s) ((uint8_t *)(s)->pixels)
+
+/* SDL only defines readback before presentation. */
+static void capture(SDL_Renderer *renderer);
+#define SDL_RenderPresent capture
+#include "slice.h"
+#undef SDL_RenderPresent
+
+static uint32_t output[128 * 96];
+static int output_width, output_height;
+
+static void capture(SDL_Renderer *renderer)
+{
+    int logical_width, logical_height;
+
+    assert(!SDL_GetRenderTarget(renderer));
+    assert(SDL_GetRendererOutputSize(renderer, &output_width, &output_height) == 0);
+    assert(output_width * output_height <= (int)(sizeof(output) / sizeof(output[0])));
+    /* Read the entire output, including pixels outside the logical viewport. */
+    SDL_RenderGetLogicalSize(renderer, &logical_width, &logical_height);
+    assert(SDL_RenderSetLogicalSize(renderer, 0, 0) == 0);
+    SDL_Rect bounds = {0, 0, output_width, output_height};
+    assert(SDL_RenderReadPixels(renderer, &bounds, SDL_PIXELFORMAT_ARGB8888,
+                                output, output_width * 4) == 0);
+    assert(SDL_RenderSetLogicalSize(renderer, logical_width, logical_height) == 0);
+    SDL_RenderPresent(renderer);
+}
+
+static void check(struct sdl2_console *scon, int width, int height, int period)
+{
+    DisplaySurface *surface = scon->surface;
+    SDL_SetWindowSize(scon->real_window, width, height);
+    SDL_PumpEvents();
+    assert(SDL_RenderSetLogicalSize(scon->real_renderer, surface->width,
+                                    surface->height) == 0);
+    /* One white column in each group. Vary the phase to catch lost strokes. */
+    for (int phase = 0; phase < period; phase++) {
+        for (int y = 0; y < surface->height; y++) {
+            for (int x = 0; x < surface->width; x++) {
+                surface->pixels[y * surface->width + x] =
+                    x % period == phase ? 0xffffffff : 0xff000000;
+            }
+        }
+        sdl2_2d_update(&scon->dcl, 0, 0, surface->width, surface->height);
+        assert(output_width == width && output_height == height);
+        int left = (width - surface->width / period) / 2;
+        int top = (height - surface->height / period) / 2;
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                int expected = x < left || x >= width - left ||
+                               y < top || y >= height - top ? 0 : 255 / period;
+                uint32_t rgb = output[y * width + x];
+                for (int shift = 0; shift < 24; shift += 8) {
+                    int value = (rgb >> shift) & 255;
+                    assert(abs(value - expected) <= 2);
+                }
+            }
+        }
+    }
+}
+
+static void check_orientation(struct sdl2_console *scon, bool landscape)
+{
+    /* Mark each native corner with a different colour. The 64x32 window
+     * letterboxes both orientations of this 96x128 panel. */
+    static const uint32_t colors[] = {0xffff0000, 0xff00ff00, 0xff0000ff, 0xffffff00};
+    DisplaySurface *s = scon->surface;
+    SDL_SetWindowSize(scon->real_window, 64, 32);
+    SDL_PumpEvents();
+    scon->landscape = landscape;
+    sdl2_2d_set_logical_size(scon);
+    for (int y = 0; y < s->height; y++) {
+        for (int x = 0; x < s->width; x++) {
+            s->pixels[y * s->width + x] =
+                colors[2 * (y >= s->height / 2) + (x >= s->width / 2)];
+        }
+    }
+    sdl2_2d_update(&scon->dcl, 0, 0, s->width, s->height);
+    int left = landscape ? 14 : 22, right = 63 - left;
+    assert(output[0] == 0xff000000);
+    assert(output[4 * 64 + left] == colors[landscape ? 1 : 0]);
+    assert(output[4 * 64 + right] == colors[landscape ? 3 : 1]);
+    assert(output[27 * 64 + left] == colors[landscape ? 0 : 2]);
+    assert(output[27 * 64 + right] == colors[landscape ? 2 : 3]);
+}
+
+int main(void)
+{
+    SDL_SetMainReady();
+    assert(SDL_setenv("SDL_VIDEODRIVER", "dummy", 1) == 0);
+    assert(SDL_Init(SDL_INIT_VIDEO) == 0);
+    assert(SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, "linear"));
+    DisplaySurface surface = { .width = 128, .height = 96 };
+    struct sdl2_console scon = { .surface = &surface };
+    scon.real_window = SDL_CreateWindow("", 0, 0, 128, 96,
+                                        SDL_WINDOW_HIDDEN | SDL_WINDOW_RESIZABLE);
+    assert(scon.real_window);
+    scon.real_renderer = SDL_CreateRenderer(scon.real_window, -1, SDL_RENDERER_SOFTWARE);
+    assert(scon.real_renderer);
+    scon.texture = SDL_CreateTexture(scon.real_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                     SDL_TEXTUREACCESS_STREAMING, 128, 96);
+    assert(scon.texture);
+    check(&scon, 48, 24, 4);  /* side bars */
+    check(&scon, 16, 24, 8);  /* top and bottom bars */
+    check(&scon, 64, 48, 2);  /* direct bilinear path */
+    /* A portrait guest surface replaces the cached landscape targets. */
+    SDL_DestroyTexture(scon.texture);
+    surface.width = 96;
+    surface.height = 128;
+    scon.texture = SDL_CreateTexture(scon.real_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                     SDL_TEXTUREACCESS_STREAMING, 96, 128);
+    assert(scon.texture);
+    check(&scon, 40, 32, 4);
+    check_orientation(&scon, true);
+    check_orientation(&scon, false);
+    SDL_DestroyRenderer(scon.real_renderer);
+    SDL_DestroyWindow(scon.real_window);
+    SDL_Quit();
+    return 0;
+}
diff --git a/tests/slice/sdl2-ipad-keys.c b/tests/slice/sdl2-ipad-keys.c
new file mode 100644
index 0000000000..28466e0072
--- /dev/null
+++ b/tests/slice/sdl2-ipad-keys.c
@@ -0,0 +1,131 @@
+/* SLICE ui/sdl2.c fn sdl2_handle_ipad_key
+ * PKG sdl2
+ * CFLAGS -Wall -Werror
+ */
+#define SDL_MAIN_HANDLED
+#include <SDL.h>
+#include <assert.h>
+#include <stdbool.h>
+#include <string.h>
+
+typedef struct { bool landscape; } Object;
+static Object machine;
+static void *error_abort;
+typedef struct { void *con; } DisplayChangeListener;
+static struct sdl2_console {
+    bool rotatable;
+    DisplayChangeListener dcl;
+    void *kbd;
+} sdl2_console[2];
+static unsigned turns;
+static unsigned button_events;
+typedef enum { Q_KEY_CODE_POWER, Q_KEY_CODE_HOME } QKeyCode;
+static QKeyCode expected_button = Q_KEY_CODE_POWER;
+static unsigned home_edges;
+
+static void qkbd_state_key_event(void *kbd, QKeyCode code, bool down)
+{
+    assert(kbd == &machine && code == Q_KEY_CODE_HOME);
+    assert(down == (home_edges == 0));
+    home_edges++;
+}
+
+static void qemu_input_event_send_key_qcode(void *con, QKeyCode code, bool down)
+{
+    assert(con == sdl2_console[0].dcl.con && code == expected_button);
+    assert(button_events % 3 == (down ? 0 : 2));
+    button_events++;
+}
+
+static void qemu_input_event_send_key_delay(unsigned ms)
+{
+    assert(button_events % 3 == 1 && ms == (expected_button == Q_KEY_CODE_HOME ? 1800 : 150));
+    button_events++;
+}
+
+static Object *qdev_get_machine(void)
+{
+    return &machine;
+}
+
+static bool object_property_get_bool(Object *obj, const char *name, void **err)
+{
+    assert(obj == &machine && !strcmp(name, "panel-landscape"));
+    return obj->landscape;
+}
+
+static void object_property_set_bool(Object *obj, const char *name,
+                                     bool landscape, void **err)
+{
+    assert(obj == &machine && !strcmp(name, "panel-landscape"));
+    obj->landscape = landscape;
+}
+
+static void sdl2_sync_orientation(struct sdl2_console *panel)
+{
+    assert(panel == &sdl2_console[0]);
+    turns++;
+}
+
+#include "slice.h"
+
+int main(void)
+{
+    SDL_KeyboardEvent key = {.type = SDL_KEYDOWN};
+    sdl2_console[0].dcl.con = &machine;
+    key.keysym.scancode = SDL_SCANCODE_F7;
+    assert(!sdl2_handle_ipad_key(&key));
+    key.keysym.scancode = SDL_SCANCODE_F6;
+    assert(!sdl2_handle_ipad_key(&key));
+    sdl2_console[0].rotatable = true;
+    assert(sdl2_handle_ipad_key(&key)); /* Windows can supply window ID 0. */
+    assert(machine.landscape && turns == 1);
+    key.repeat = 1;
+    assert(sdl2_handle_ipad_key(&key));
+    key.type = SDL_KEYUP;
+    key.repeat = 0;
+    assert(sdl2_handle_ipad_key(&key));
+    assert(machine.landscape && turns == 1);
+    key.type = SDL_KEYDOWN;
+    key.windowID = 2;
+    assert(sdl2_handle_ipad_key(&key));
+    assert(!machine.landscape && turns == 2);
+    assert(button_events == 0);
+    key.keysym.scancode = SDL_SCANCODE_F7;
+    for (unsigned press = 1; press <= 2; press++) {
+        key.type = SDL_KEYDOWN;
+        assert(sdl2_handle_ipad_key(&key));
+        key.repeat = 1;
+        assert(sdl2_handle_ipad_key(&key));
+        key.repeat = 0;
+        key.type = SDL_KEYUP;
+        assert(sdl2_handle_ipad_key(&key));
+        assert(button_events == press * 3 && turns == 2);
+    }
+    key.keysym.scancode = SDL_SCANCODE_F8;
+    expected_button = Q_KEY_CODE_HOME;
+    key.type = SDL_KEYDOWN;
+    assert(sdl2_handle_ipad_key(&key));
+    key.repeat = 1;
+    assert(sdl2_handle_ipad_key(&key));
+    key.type = SDL_KEYUP;
+    key.repeat = 0;
+    assert(sdl2_handle_ipad_key(&key));
+    assert(button_events == 9 && turns == 2);
+    sdl2_console[0].rotatable = false;
+    assert(!sdl2_handle_ipad_key(&key));
+    key.keysym.scancode = SDL_SCANCODE_HOME;
+    assert(!sdl2_handle_ipad_key(&key));
+    sdl2_console[0].rotatable = true;
+    sdl2_console[0].kbd = &machine;
+    key.windowID = 0;
+    key.type = SDL_KEYDOWN;
+    assert(sdl2_handle_ipad_key(&key));
+    key.repeat = 1;
+    assert(sdl2_handle_ipad_key(&key));
+    key.repeat = 0;
+    key.type = SDL_KEYUP;
+    assert(sdl2_handle_ipad_key(&key));
+    assert(home_edges == 2);
+    return 0;
+}
