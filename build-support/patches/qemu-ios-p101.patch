diff --git a/hw/arm/s5l8955_edp.c b/hw/arm/s5l8955_edp.c
new file mode 100644
index 0000000000..5b88c3452d
--- /dev/null
+++ b/hw/arm/s5l8955_edp.c
@@ -0,0 +1,200 @@
+/*
+ * S5L8955 embedded DisplayPort transmitter for the virtual iPad panel.
+ * The Analogix AUX register layout is shared with Samsung Exynos.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/arm/s5l8955.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/display/dpcd.h"
+#include "hw/display/i2c-ddc.h"
+#include "hw/misc/auxbus.h"
+
+#define TYPE_S5L8955_EDP "s5l8955.edp"
+OBJECT_DECLARE_SIMPLE_TYPE(S5L8955EDPState, S5L8955_EDP)
+
+enum {
+    INT_STATUS = 0x3dc / 4,
+    INT_MASK = 0x3f8 / 4,
+    SYS_CTL_1 = 0x600 / 4,
+    SYS_CTL_3 = 0x608 / 4,
+    DEBUG_CTL = 0x6c0 / 4,
+    AUX_STATUS = 0x780 / 4,
+    AUX_REPLY = 0x78c / 4,
+    AUX_BUFFER_CTL = 0x790 / 4,
+    AUX_COMMAND = 0x794 / 4,
+    AUX_ADDR_LOW = 0x798 / 4,
+    AUX_ADDR_MID = 0x79c / 4,
+    AUX_ADDR_HIGH = 0x7a0 / 4,
+    AUX_START = 0x7a4 / 4,
+    AUX_BUFFER = 0x7c0 / 4,
+};
+
+struct S5L8955EDPState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    qemu_irq irq;
+    AUXBus *aux;
+    uint16_t width, height;
+    uint32_t regs[0x2000 / 4];
+};
+
+static void edp_update_irq(S5L8955EDPState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[INT_STATUS] & s->regs[INT_MASK]));
+}
+
+static void edp_aux_transfer(S5L8955EDPState *s, bool address_only)
+{
+    uint32_t cmd = s->regs[AUX_COMMAND];
+    uint32_t addr = (s->regs[AUX_ADDR_LOW] & 0xff) |
+                    ((s->regs[AUX_ADDR_MID] & 0xff) << 8) |
+                    ((s->regs[AUX_ADDR_HIGH] & 0xf) << 16);
+    uint8_t data[16] = {0};
+    unsigned length = address_only ? 0 : ((cmd >> 4) & 0xf) + 1;
+    AUXReply reply;
+
+    for (unsigned i = 0; i < length; i++) {
+        data[i] = s->regs[AUX_BUFFER + i];
+    }
+    reply = aux_request(s->aux, cmd & 0xf, addr, length, data);
+    for (unsigned i = 0; i < length; i++) {
+        s->regs[AUX_BUFFER + i] = data[i];
+    }
+    s->regs[AUX_BUFFER_CTL] = length;
+    s->regs[AUX_REPLY] = reply;
+    s->regs[AUX_STATUS] = reply ? 1 : 0;
+    s->regs[INT_STATUS] |= reply ? 1 : 2;
+    edp_update_irq(s);
+}
+
+static uint64_t edp_read(void *opaque, hwaddr off, unsigned size)
+{
+    S5L8955EDPState *s = opaque;
+    return s->regs[off / 4];
+}
+
+static void edp_write(void *opaque, hwaddr off, uint64_t value, unsigned size)
+{
+    S5L8955EDPState *s = opaque;
+    unsigned reg = off / 4;
+
+    switch (reg) {
+    case INT_STATUS:
+        s->regs[reg] &= ~value;
+        edp_update_irq(s);
+        break;
+    case INT_MASK:
+        s->regs[reg] = value;
+        edp_update_irq(s);
+        break;
+    case AUX_BUFFER_CTL:
+        if (value & 0x80) {
+            memset(&s->regs[AUX_BUFFER], 0, 16 * sizeof(uint32_t));
+            s->regs[reg] = 0;
+        }
+        break;
+    case AUX_START:
+        s->regs[reg] = value & ~1u;
+        if (value & 1) {
+            edp_aux_transfer(s, value & 2);
+        }
+        break;
+    case SYS_CTL_1:
+        s->regs[reg] = value | (1u << 2); /* input clock detected */
+        break;
+    case SYS_CTL_3:
+        s->regs[reg] = value | (1u << 6) | (1u << 2); /* HPD and stream valid */
+        break;
+    case DEBUG_CTL:
+        s->regs[reg] = value | (1u << 4); /* PLL locked */
+        break;
+    default:
+        s->regs[reg] = value;
+        break;
+    }
+}
+
+static const MemoryRegionOps edp_ops = {
+    .read = edp_read,
+    .write = edp_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void edp_init(Object *obj)
+{
+    S5L8955EDPState *s = S5L8955_EDP(obj);
+    SysBusDevice *dev = SYS_BUS_DEVICE(obj);
+
+    s->aux = aux_bus_init(DEVICE(obj), "aux");
+    memory_region_init_io(&s->mmio, obj, &edp_ops, s, TYPE_S5L8955_EDP, 0x2000);
+    sysbus_init_mmio(dev, &s->mmio);
+    sysbus_init_irq(dev, &s->irq);
+}
+
+static void edp_realize(DeviceState *dev, Error **errp)
+{
+    S5L8955EDPState *s = S5L8955_EDP(dev);
+    DeviceState *dpcd = qdev_new(TYPE_DPCD);
+    I2CSlave *edid = i2c_slave_new(TYPE_I2CDDC, 0x50);
+    I2CDDCState *ddc = I2CDDC(edid);
+    qemu_edid_info info = {
+        .prefx = s->width,
+        .prefy = s->height,
+        .refresh_rate = 60000,
+        .width_mm = 148,
+        .height_mm = 197,
+    };
+
+    aux_bus_realize(s->aux);
+    qdev_prop_set_uint8(dpcd, "max-link-rate", DPCD_2_7GBPS);
+    qdev_realize_and_unref(dpcd, BUS(s->aux), &error_fatal);
+    aux_map_slave(AUX_SLAVE(dpcd), 0);
+    qemu_edid_generate(ddc->edid_blob, sizeof(ddc->edid_blob), &info);
+    i2c_slave_realize_and_unref(edid, aux_get_i2c_bus(s->aux), &error_fatal);
+}
+
+static void edp_reset(DeviceState *dev)
+{
+    S5L8955EDPState *s = S5L8955_EDP(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[SYS_CTL_1] = 1u << 2;
+    s->regs[SYS_CTL_3] = (1u << 6) | (1u << 2);
+    s->regs[DEBUG_CTL] = 1u << 4;
+    edp_update_irq(s);
+}
+
+static const Property edp_properties[] = {
+    DEFINE_PROP_UINT16("width", S5L8955EDPState, width, P101_PANEL_WIDTH),
+    DEFINE_PROP_UINT16("height", S5L8955EDPState, height, P101_PANEL_HEIGHT),
+};
+
+static void edp_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = edp_realize;
+    device_class_set_props(dc, edp_properties);
+    device_class_set_legacy_reset(dc, edp_reset);
+}
+
+static const TypeInfo edp_type = {
+    .name = TYPE_S5L8955_EDP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(S5L8955EDPState),
+    .instance_init = edp_init,
+    .class_init = edp_class_init,
+};
+
+static void edp_register_types(void)
+{
+    type_register_static(&edp_type);
+}
+type_init(edp_register_types)
