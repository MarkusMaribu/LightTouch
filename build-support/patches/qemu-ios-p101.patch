@@ -0,0 +1,25 @@
+#ifndef HW_ARM_IOS_BYTES_H
+#define HW_ARM_IOS_BYTES_H
+
+/* The input can be a binary image containing embedded zero bytes. */
+static inline bool ios_bytes_contains(const uint8_t *data, size_t length,
+                                      const char *needle, size_t needle_length)
+{
+    if (!needle_length) {
+        return true;
+    }
+    while (length >= needle_length) {
+        const uint8_t *at = memchr(data, needle[0], length - needle_length + 1);
+        if (!at) {
+            break;
+        }
+        if (!memcmp(at, needle, needle_length)) {
+            return true;
+        }
+        length -= at - data + 1;
