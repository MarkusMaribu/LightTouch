+static void sdl2_fit_size(int *width, int *height, int max_w, int max_h)
+{
+    max_w = MAX(1, max_w);
+    max_h = MAX(1, max_h);
+    if (*width <= max_w && *height <= max_h) {
+        return;
+    }
+    if ((int64_t)*width * max_h > (int64_t)*height * max_w) {
+        *height = MAX(1, (int64_t)*height * max_w / *width);
+        *width = max_w;
+    } else {
+        *width = MAX(1, (int64_t)*width * max_h / *height);
+        *height = max_h;
+    }
+}
+
+static void sdl2_size_window(struct sdl2_console *scon, bool center, bool turn)
+{
+    SDL_Window *window = scon->real_window;
+    SDL_Rect work;
+    int width = surface_width(scon->surface);
+    int height = surface_height(scon->surface);
+    int display = SDL_GetWindowDisplayIndex(window);
+    int x, y, top, left, bottom, right;
+
+    if (turn) {
+        /* Keep the user's current client size, with its axes exchanged. */
+        SDL_GetWindowSize(window, &height, &width);
+    } else if (scon->landscape) {
+        width = surface_height(scon->surface);
+        height = surface_width(scon->surface);
+    }
+    if (SDL_GetWindowFlags(window) & (SDL_WINDOW_FULLSCREEN |
+                                    SDL_WINDOW_MAXIMIZED)) {
+        return;
+    }
+    if (display < 0) {
+        display = 0;
+    }
+    if (SDL_GetDisplayUsableBounds(display, &work) < 0 &&
+        SDL_GetDisplayBounds(display, &work) < 0) {
+        return;
+    }
+    if (SDL_GetWindowBordersSize(window, &top, &left, &bottom, &right) < 0) {
+        /* Some window managers only report decorations once shown. */
+        top = 40;
+        left = bottom = right = 8;
+    }
+    work.x += left;
+    work.y += top;
+    work.w -= left + right;
+    work.h -= top + bottom;
+    if (work.w < 1 || work.h < 1) {
+        return;
+    }
+
