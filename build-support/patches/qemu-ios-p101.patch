+    assert(timer.armed);
+    timer.armed = false;
+    a6_pmu_adc_complete(&s);
+    assert(s.regs[0x48] == (0x80 | 33));
+    assert(s.regs[0x0a] == 4 && irq_level == 1);
+    write_reg(&s, 0x1e, 0xfb);
+    assert(irq_level == 0);
+    address(&s, 0x49);
