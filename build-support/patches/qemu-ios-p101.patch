+    if (!panel->rotatable) {
+        return false;
+    }
+    if (code == SDL_SCANCODE_HOME) {
+        /* Some Windows key events have window ID zero. Track the real hold
+         * on the iPad keyboard so losing focus also releases the button. */
+        if (!key->repeat) {
+            qkbd_state_key_event(panel->kbd, Q_KEY_CODE_HOME, key->type == SDL_KEYDOWN);
+        }
+        return true;
+    }
+    if (code != SDL_SCANCODE_F6 && code != SDL_SCANCODE_F7 && code != SDL_SCANCODE_F8) {
+        return false;
+    }
+    if (key->type != SDL_KEYDOWN || key->repeat) {
+        return true;
+    }
+    if (code != SDL_SCANCODE_F6) {
+        bool siri = code == SDL_SCANCODE_F8;
+        QKeyCode button = siri ? Q_KEY_CODE_HOME : Q_KEY_CODE_POWER;
+
+        qemu_input_event_send_key_qcode(panel->dcl.con, button, true);
+        qemu_input_event_send_key_delay(siri ? 1800 : 150);
+        qemu_input_event_send_key_qcode(panel->dcl.con, button, false);
+    } else {
+        Object *machine = qdev_get_machine();
+        bool landscape = object_property_get_bool(machine, "panel-landscape", &error_abort);
+        object_property_set_bool(machine, "panel-landscape", !landscape, &error_abort);
+        sdl2_sync_orientation(panel);
+    }
+    return true;
