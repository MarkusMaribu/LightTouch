+/* SLICE:types hw/arm/s5l8930_display.c typedef PanelDamage
+ * SLICE hw/arm/s5l8930_display.c fn panel_damage
+ */
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#include "types.h"
+#include "slice.h"
+
+int main(void)
+{
+    enum { W = 97, H = 11 };
+    uint32_t old[W * H] = {0}, now[W * H] = {0};
+    for (unsigned y = 2; y <= 6; y++) {
+        for (unsigned x = 32; x < 51; x++) {
+            now[y * W + x] = 1;
+        }
+    }
+    PanelDamage d = panel_damage(old, now, W, H);
+    assert(d.top == 2 && d.bottom == 7 && d.left == 32 && d.right >= 51 && d.right < W);
+    now[0] = 2;
+    now[W * H - 1] = 3;
+    d = panel_damage(old, now, W, H);
+    assert(d.left == 0 && d.right == W && d.top == 0 && d.bottom == H);
+    d = panel_damage(now, now, W, H);
+    assert(d.top == d.bottom);
+    return 0;
+}
