+/* SLICE:types include/hw/arm/s5l8955.h define P101_PANEL_.*
+ * SLICE:types include/hw/arm/s5l8930.h typedef A4DTEdit
+ * SLICE hw/arm/s5l8950.c fn p101_prepare_display
+ * SLICE hw/arm/s5l8950.c fn p101_splash_row
+ * SLICE:scan hw/arm/s5l8930_display.c define DP_SIZE[[:space:]]
+ * SLICE:scan hw/arm/s5l8930_display.c fn panel_size
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include "types.h"
+
+/* The slice runs on the little-endian host used to build the Windows engine. */
+#define cpu_to_le32(v) (v)
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+static void stl_le_p(void *dst, uint32_t n) { memcpy(dst, &n, 4); }
+
+static unsigned scale, ppi;
+static void a4_dt_edit(uint8_t *image, size_t len, uint32_t base, uint32_t args,
+                       const A4DTEdit *edit)
+{
+    assert(edit->vlen == 4);
+    if (!strcmp(edit->name, "chosen") && !strcmp(edit->prop, "display-scale")) {
+        memcpy(&scale, edit->value, 4);
+    } else {
+        assert(!strcmp(edit->name, "clcd") && !strcmp(edit->prop, "dot-pitch"));
+        memcpy(&ppi, edit->value, 4);
+    }
+}
+#include "slice.h"
+
+typedef struct { uint32_t regs[0x2000 / 4]; } DisplayPipe;
+typedef struct {
+    DisplayPipe pipe[1];
+    bool h5p;
+    unsigned pw, ph, width, height;
+} S5L8930DisplayState;
+static uint32_t panel_word(DisplayPipe *pipe, unsigned offset, uint32_t v) { return v; }
+#include "scan.h"
+
+int main(void)
+{
+    uint32_t words[16] = {0};
+    for (unsigned density = 1; density <= 2; density++) {
+        /* Simulate an existing bundle with the previous landscape geometry. */
+        words[8] = 2048;
+        words[9] = 1536;
+        assert(p101_prepare_display((uint8_t *)words, sizeof(words), 0x8000,
+                                    0x8000, 768 * density, 1024 * density));
+        assert(words[7] == 3072 * density && words[8] == 768 * density);
+        assert(words[9] == 1024 * density && words[10] == (32 | ((density-1) << 16)));
+        assert(scale == density && ppi == 132 * density);
+    }
+    assert(!p101_prepare_display((uint8_t *)words, 0x37, 8, 8, 768, 1024));
+    assert(!p101_prepare_display((uint8_t *)words, sizeof(words), 8, 7, 768, 1024));
+    S5L8930DisplayState s = {.h5p = true, .width = 1536, .height = 2048};
+    unsigned w, h;
+    s.pipe[0].regs[DP_SIZE / 4] = 2048u << 16 | 1536;
+    panel_size(&s, &w, &h);
+    assert(w == 2048 && h == 1536);
+    s.pipe[0].regs[DP_SIZE / 4] = 0;
+    panel_size(&s, &w, &h);
+    assert(w == 1536 && h == 2048);
+    uint32_t logo[2048] = {0}, row[1536] = {0};
+    logo[1024] = 0x203040;
+    assert(p101_splash_row(row, 1536, 2048, 1024, (const uint8_t *)logo,
+                           2048, 1536, 768, 1));
+    assert(row[768] == logo[1024] && !row[767] && !row[769]);
+    assert(p101_splash_row(row, 768, 1024, 512, (const uint8_t *)logo,
+                           2048, 1536, 768, 1));
+    assert(row[384] == logo[1024] && !row[383] && !row[385]);
+    assert(!p101_splash_row(row, 768, 1024, 511, (const uint8_t *)logo,
+                            2048, 1536, 768, 1));
+    return 0;
+}
