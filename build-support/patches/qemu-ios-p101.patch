+typedef struct PanelDamage {
+    unsigned left, top, right, bottom;
+} PanelDamage;
+
+/* Compare complete rows to find the vertical span. Within it, trim 32-pixel
+ * columns until each side touches at least one changed pixel. */
+static PanelDamage panel_damage(const uint32_t *old, const uint32_t *now,
+                                unsigned w, unsigned h)
+{
+    PanelDamage box = {0, 0, w, h};
+    while (box.top < h &&
+           !memcmp(old + box.top * w, now + box.top * w, w * 4)) {
+        box.top++;
+    }
+    while (box.bottom > box.top &&
+           !memcmp(old + (box.bottom - 1) * w, now + (box.bottom - 1) * w, w * 4)) {
+        box.bottom--;
+    }
+    if (box.top == box.bottom) {
+        return box;
+    }
+    unsigned left = w, right = 0;
+    for (unsigned y = box.top; y < box.bottom && (left || right < w); y++) {
+        const uint32_t *a = old + y * w, *b = now + y * w;
+        for (unsigned x = 0; x < left; x += 32) {
+            if (memcmp(a + x, b + x, MIN(32u, left - x) * 4)) {
+                left = x;
+                break;
+            }
+        }
+        for (unsigned x = w; x > right;) {
+            unsigned n = MIN(32u, x - right);
+            if (memcmp(a + x - n, b + x - n, n * 4)) {
+                right = x;
+                break;
+            }
+            x -= n;
+        }
+    }
+    box.left = left;
+    box.right = right;
+    return box;
+}
