+    a6_pmu_reset(&s);
+    assert(s.regs[0x15] == 0xff && s.regs[0x1e] == 0xff && irq_level == 1);
+    /* GPIO14 is high on an uncovered iPad. Keep the other inputs intact. */
+    s.regs[0x0e] = 0x05;
+    address(&s, 0x0e);
+    assert(a6_pmu_recv(&s) == 0x45);
+
+    /* No conversion during preconditioning, or from channel-select bit 5. */
+    write_reg(&s, 0x48, 0x80 | 33);
